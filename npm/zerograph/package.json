{
  "name": "zerograph",
  "version": "0.6.0",
  "description": "Knowledge graph of a repository's requirement docs and code in 24 languages, built and refreshed at zero model tokens, asked by id, keyword or paraphrase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaxxx/zerograph.git"
  },
  "homepage": "https://github.com/devmaxxx/zerograph#readme",
  "keywords": [
    "knowledge-graph",
    "requirements",
    "traceability",
    "typescript",
    "search",
    "bm25",
    "embeddings",
    "claude-code"
  ],
  "bin": {
    "zerograph": "bin/zerograph.js"
  },
  "files": [
    "bin/zerograph.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "zerograph-darwin-arm64": "0.6.0",
    "zerograph-linux-x64": "0.6.0",
    "zerograph-win32-x64": "0.6.0"
  }
}
